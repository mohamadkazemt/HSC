[Unit]
Description=Celery Worker Service for HSC Project
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=simple
User=hsc_admin
Group=hsc_admin
WorkingDirectory=/var/www/HSC

# Environment Variables
Environment="DJANGO_SETTINGS_MODULE=HSCprojects.settings.production"
Environment="PATH=/var/www/HSC/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="LANG=en_US.UTF-8"
Environment="LC_ALL=en_US.UTF-8"

# Celery Worker Command
ExecStart=/var/www/HSC/venv/bin/celery -A HSCprojects worker \
    --pool=prefork \
    --concurrency=8 \
    --max-tasks-per-child=1000 \
    --loglevel=info \
    --logfile=/var/www/HSC/logs/celery-worker.log \
    --hostname=worker@%h

# Graceful shutdown
ExecStop=/bin/kill -s TERM $MAINPID
ExecReload=/bin/kill -s HUP $MAINPID

# Restart policy
Restart=always
RestartSec=10s

# Process management
KillMode=mixed
TimeoutStopSec=30
TimeoutStartSec=60

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=celery-worker

# Security
PrivateTmp=true
NoNewPrivileges=true

# Resource limits (optional)
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target

