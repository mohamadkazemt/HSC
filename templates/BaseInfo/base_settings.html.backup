{% extends 'base.html' %}
{% load static %}
{% block title %}تنظیمات پایه{% endblock %}

{% block styles %}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tarekraafat/autocomplete.js@10.2.7/dist/css/autoComplete.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@majidh1/jalalidatepicker/dist/jalalidatepicker.min.css">
{% endblock %}

{% block content %}
<div x-data="coreSettings()" x-init="init()" class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-xl font-bold">تنظیمات داده‌های پایه</h1>
  </div>

  <!-- Tabs -->
  <div class="border-b border-gray-200 dark:border-gray-700">
    <nav class="flex -mb-px space-x-4 rtl:space-x-reverse" aria-label="Tabs">
      <template x-for="tab in tabs" :key="tab.key">
        <a href="#" @click.prevent="activeTab = tab.key" 
           :class="activeTab === tab.key ? 'border-brand-600 text-brand-600 dark:text-white' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 dark:text-gray-400 dark:hover:text-white'"
           class="whitespace-nowrap border-b-2 py-4 px-1 text-sm font-medium">
          <span x-text="tab.label"></span>
        </a>
      </template>
    </nav>
  </div>

  <!-- Tab Panels -->
  <div class="space-y-10">
    <!-- Mining Machines -->
    <section x-show="activeTab === 'machines'" x-cloak class="space-y-4">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-semibold">مدیریت دستگاه‌های معدنی</h2>
        <div class="flex gap-2">
          <label class="inline-flex items-center gap-2 rounded-md bg-green-600 px-4 py-2 text-white hover:bg-green-700 cursor-pointer">
            <input type="file" @change="importFile($event, 'machines')" accept=".xlsx,.csv" class="hidden">
            ایمپورت فایل
          </label>
          <button @click="openMachineModal()" class="inline-flex items-center gap-2 rounded-md bg-brand-600 px-4 py-2 text-white hover:bg-brand-700">
            افزودن دستگاه جدید
          </button>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <div class="relative w-full max-w-xs">
          <input x-model.debounce.300ms="filters.machines.search" type="text" placeholder="جستجو..." class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500 dark:bg-gray-800 dark:border-gray-700" />
        </div>
      </div>
      <div class="overflow-hidden rounded-lg border border-gray-200 dark:border-gray-700">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
          <thead class="bg-gray-50 dark:bg-gray-800/50">
            <tr>
              <th class="px-4 py-2 text-right text-xs font-medium text-gray-500">کد کارگاهی</th>
              <th class="px-4 py-2 text-right text-xs font-medium text-gray-500">نوع دستگاه</th>
              <th class="px-4 py-2 text-right text-xs font-medium text-gray-500">گروه کاری</th>
              <th class="px-4 py-2 text-right text-xs font-medium text-gray-500">مالکیت</th>
              <th class="px-4 py-2 text-right text-xs font-medium text-gray-500">پیمانکار</th>
              <th class="px-4 py-2 text-right text-xs font-medium text-gray-500">فعال</th>
              <th class="px-4 py-2"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 dark:divide-gray-700 bg-white dark:bg-gray-900">
            <template x-for="item in state.machines" :key="item.id">
              <tr>
                <td class="px-4 py-2 text-sm" x-text="item.workshop_code"></td>
                <td class="px-4 py-2 text-sm" x-text="item.machine_type"></td>
                <td class="px-4 py-2 text-sm" x-text="item.machine_workgroup"></td>
                <td class="px-4 py-2 text-sm" x-text="item.ownership"></td>
                <td class="px-4 py-2 text-sm" x-text="item.contractor"></td>
                <td class="px-4 py-2 text-sm">
                  <button @click="toggleMachineActive(item)" :class="item.is_active ? 'bg-green-500' : 'bg-gray-300'" class="relative inline-flex h-6 w-11 items-center rounded-full transition">
                    <span class="inline-block h-4 w-4 transform rounded-full bg-white transition" :class="item.is_active ? 'translate-x-6' : 'translate-x-1'"></span>
                  </button>
                </td>
                <td class="px-4 py-2">
                  <div class="flex items-center gap-2">
                    <button @click="openMachineModal(item)" class="text-brand-600 hover:text-brand-700 text-sm">ویرایش</button>
                    <button @click="confirmDelete('machine', item)" class="text-red-600 hover:text-red-700 text-sm">حذف</button>
                  </div>
                </td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Blocks -->
    <section x-show="activeTab === 'blocks'" x-cloak class="space-y-4">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-semibold">مدیریت بلوک‌ها</h2>
        <button @click="openBlockModal()" class="inline-flex items-center gap-2 rounded-md bg-brand-600 px-4 py-2 text-white hover:bg-brand-700">
          افزودن بلوک جدید
        </button>
      </div>
      <div class="overflow-hidden rounded-lg border border-gray-200 dark:border-gray-700">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
          <thead class="bg-gray-50 dark:bg-gray-800/50">
            <tr>
              <th class="px-4 py-2 text-right text-xs font-medium text-gray-500">نام بلوک</th>
              <th class="px-4 py-2 text-right text-xs font-medium text-gray-500">نوع</th>
              <th class="px-4 py-2 text-right text-xs font-medium text-gray-500">وضعیت</th>
              <th class="px-4 py-2 text-right text-xs font-medium text-gray-500">موقعیت</th>
              <th class="px-4 py-2 text-right text-xs font-medium text-gray-500">فعال</th>
              <th class="px-4 py-2"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 dark:divide-gray-700 bg-white dark:bg-gray-900">
            <template x-for="item in state.blocks" :key="item.id">
              <tr>
                <td class="px-4 py-2 text-sm" x-text="item.block_name"></td>
                <td class="px-4 py-2 text-sm"><span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium" :class="badgeForBlockType(item.type)"><span x-text="item.type"></span></span></td>
                <td class="px-4 py-2 text-sm"><span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium" :class="badgeForBlockStatus(item.status)"><span x-text="item.status"></span></span></td>
                <td class="px-4 py-2 text-sm" x-text="item.location"></td>
                <td class="px-4 py-2 text-sm">
                  <span class="inline-flex h-5 w-10 items-center rounded-full" :class="item.is_active ? 'bg-green-500/20 text-green-700' : 'bg-gray-300/40 text-gray-700'">
                    <span x-text="item.is_active ? 'فعال' : 'غیرفعال'" class="mx-auto text-xs"></span>
                  </span>
                </td>
                <td class="px-4 py-2">
                  <div class="flex items-center gap-2">
                    <button @click="openBlockModal(item)" class="text-brand-600 hover:text-brand-700 text-sm">ویرایش</button>
                    <button @click="confirmDelete('block', item)" class="text-red-600 hover:text-red-700 text-sm">حذف</button>
                  </div>
                </td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Emergency Vehicles -->
    <section x-show="activeTab === 'vehicles'" x-cloak class="space-y-4">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-semibold">مدیریت خودروهای امدادی</h2>
        <button @click="openVehicleModal()" class="inline-flex items-center gap-2 rounded-md bg-brand-600 px-4 py-2 text-white hover:bg-brand-700">
          افزودن خودرو جدید
        </button>
      </div>
      <div class="overflow-hidden rounded-lg border border-gray-200 dark:border-gray-700">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
          <thead class="bg-gray-50 dark:bg-gray-800/50">
            <tr>
              <th class="px-4 py-2 text-right text-xs font-medium text-gray-500">کد کارگاهی</th>
              <th class="px-4 py-2 text-right text-xs font-medium text-gray-500">نوع</th>
              <th class="px-4 py-2 text-right text-xs font-medium text-gray-500">وضعیت</th>
              <th class="px-4 py-2 text-right text-xs font-medium text-gray-500">تاریخ سرویس بعدی</th>
              <th class="px-4 py-2 text-right text-xs font-medium text-gray-500">پایان بیمه</th>
              <th class="px-4 py-2"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 dark:divide-gray-700 bg-white dark:bg-gray-900">
            <template x-for="item in state.vehicles" :key="item.id">
              <tr>
                <td class="px-4 py-2 text-sm" x-text="item.workshop_code"></td>
                <td class="px-4 py-2 text-sm" x-text="item.vehicle_type"></td>
                <td class="px-4 py-2 text-sm"><span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium" :class="badgeForVehicleStatus(item.status)"><span x-text="item.status"></span></span></td>
                <td class="px-4 py-2 text-sm" x-text="formatDate(item.next_maintenance_date)"></td>
                <td class="px-4 py-2 text-sm" x-text="formatDate(item.insurance_expiry)"></td>
                <td class="px-4 py-2">
                  <div class="flex items-center gap-2">
                    <button @click="openVehicleModal(item)" class="text-brand-600 hover:text-brand-700 text-sm">ویرایش</button>
                    <button @click="confirmDelete('vehicle', item)" class="text-red-600 hover:text-red-700 text-sm">حذف</button>
                  </div>
                </td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Simple tabs: mineral types, workgroups, machine types, dumps -->
    <template x-for="simple in simpleTabs" :key="simple.key">
      <section x-show="activeTab === simple.key" x-cloak class="space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="text-lg font-semibold" x-text="simple.title"></h2>
          <button @click="openSimpleModal(simple.key)" class="inline-flex items-center gap-2 rounded-md bg-brand-600 px-4 py-2 text-white hover:bg-brand-700">
            افزودن مورد جدید
          </button>
        </div>
        <div class="overflow-hidden rounded-lg border border-gray-200 dark:border-gray-700">
          <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
            <thead class="bg-gray-50 dark:bg-gray-800/50">
              <tr>
                <th class="px-4 py-2 text-right text-xs font-medium text-gray-500">نام</th>
                <th class="px-4 py-2 text-right text-xs font-medium text-gray-500">توضیحات</th>
                <th class="px-4 py-2"></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-gray-700 bg-white dark:bg-gray-900">
              <template x-for="item in state[simple.stateKey]" :key="item.id">
                <tr>
                  <td class="px-4 py-2 text-sm" x-text="item.name"></td>
                  <td class="px-4 py-2 text-sm" x-text="item.description"></td>
                  <td class="px-4 py-2">
                    <div class="flex items-center gap-2">
                      <button @click="openSimpleModal(simple.key, item)" class="text-brand-600 hover:text-brand-700 text-sm">ویرایش</button>
                      <button @click="confirmDelete(simple.key, item)" class="text-red-600 hover:text-red-700 text-sm">حذف</button>
                    </div>
                  </td>
                </tr>
              </template>
            </tbody>
          </table>
        </div>
      </section>
    </template>
  </div>

  <!-- Machine Modal -->
  <div x-show="modals.machine" x-cloak class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4">
    <div @click.away="closeMachineModal()" class="w-full max-w-2xl rounded-lg bg-white p-4 shadow-xl dark:bg-gray-800">
      <h3 class="text-lg font-semibold mb-4" x-text="machineForm.id ? 'ویرایش دستگاه' : 'افزودن دستگاه جدید'"></h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <label class="block text-sm mb-1">کد کارگاهی</label>
          <input x-model="machineForm.workshop_code" class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500 dark:bg-gray-900 dark:border-gray-700" />
        </div>
        <div>
          <label class="block text-sm mb-1">گروه کاری</label>
          <select x-model.number="machineForm.machine_workgroup" @change="fetchMachineTypes(machineForm.machine_workgroup)" class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500 dark:bg-gray-900 dark:border-gray-700">
            <option value="">-- انتخاب --</option>
            {% for wg in workgroups %}
            <option value="{{ wg.id }}">{{ wg.name }}</option>
            {% endfor %}
          </select>
        </div>
        <div>
          <label class="block text-sm mb-1">نوع دستگاه</label>
          <select x-model.number="machineForm.machine_type" class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500 dark:bg-gray-900 dark:border-gray-700">
            <template x-for="mt in machineTypeOptions" :key="mt.id">
              <option :value="mt.id" x-text="mt.name"></option>
            </template>
          </select>
        </div>
        <div>
          <label class="block text-sm mb-1">مالکیت</label>
          <select x-model="machineForm.ownership" class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500 dark:bg-gray-900 dark:border-gray-700">
            <option value="Company">شرکت</option>
            <option value="Contractor">پیمانکار</option>
          </select>
        </div>
        <div x-show="machineForm.ownership === 'Contractor'">
          <label class="block text-sm mb-1">پیمانکار</label>
          <select x-model.number="machineForm.contractor" class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500 dark:bg-gray-900 dark:border-gray-700">
            <option value="">-- انتخاب --</option>
            {% for c in contractors %}
            <option value="{{ c.id }}">{{ c.name }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="flex items-center gap-2 mt-2">
          <input type="checkbox" x-model="machineForm.is_active" id="is_active" class="rounded border-gray-300 text-brand-600 focus:ring-brand-500">
          <label for="is_active" class="text-sm">فعال</label>
        </div>
      </div>
      <div class="mt-4 flex items-center justify-end gap-2">
        <button @click="closeMachineModal()" class="rounded-md border px-4 py-2 text-sm">انصراف</button>
        <button @click="saveMachine()" class="rounded-md bg-brand-600 px-4 py-2 text-sm text-white">ذخیره</button>
      </div>
    </div>
  </div>

  <!-- Block Modal -->
  <div x-show="modals.block" x-cloak class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4">
    <div @click.away="closeBlockModal()" class="w-full max-w-xl rounded-lg bg-white p-4 shadow-xl dark:bg-gray-800">
      <h3 class="text-lg font-semibold mb-4" x-text="blockForm.id ? 'ویرایش بلوک' : 'افزودن بلوک جدید'"></h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <label class="block text-sm mb-1">نام بلوک</label>
          <input x-model="blockForm.block_name" class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500 dark:bg-gray-900 dark:border-gray-700" />
        </div>
        <div>
          <label class="block text-sm mb-1">نوع</label>
          <select x-model="blockForm.type" class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500 dark:bg-gray-900 dark:border-gray-700">
            <option value="w">باطله</option>
            <option value="o">سنگ پرعیار</option>
            <option value="w&o">ترکیبی</option>
          </select>
        </div>
        <div>
          <label class="block text-sm mb-1">وضعیت</label>
          <select x-model="blockForm.status" class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500 dark:bg-gray-900 dark:border-gray-700">
            <option value="initial_preparation">آماده سازی اولیه</option>
            <option value="ready_for_drilling">آماده حفاری</option>
            <option value="ready_for_blasting">آماده آتش باری</option>
            <option value="ready_for_loading">آماده بارگیری</option>
            <option value="loading">در حال بارگیری</option>
            <option value="completed">اتمام بلوک</option>
          </select>
        </div>
        <div class="sm:col-span-2">
          <label class="block text-sm mb-1">موقعیت</label>
          <input x-model="blockForm.location" class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500 dark:bg-gray-900 dark:border-gray-700" />
        </div>
        <div class="flex items-center gap-2 mt-2">
          <input type="checkbox" x-model="blockForm.is_active" id="block_is_active" class="rounded border-gray-300 text-brand-600 focus:ring-brand-500">
          <label for="block_is_active" class="text-sm">فعال</label>
        </div>
      </div>
      <div class="mt-4 flex items-center justify-end gap-2">
        <button @click="closeBlockModal()" class="rounded-md border px-4 py-2 text-sm">انصراف</button>
        <button @click="saveBlock()" class="rounded-md bg-brand-600 px-4 py-2 text-sm text-white">ذخیره</button>
      </div>
    </div>
  </div>

  <!-- Vehicle Modal -->
  <div x-show="modals.vehicle" x-cloak class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4">
    <div @click.away="closeVehicleModal()" class="w-full max-w-3xl rounded-lg bg-white p-4 shadow-xl dark:bg-gray-800">
      <h3 class="text-lg font-semibold mb-4" x-text="vehicleForm.id ? 'ویرایش خودرو' : 'افزودن خودرو جدید'"></h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        <div>
          <label class="block text-sm mb-1">کد کارگاهی</label>
          <input x-model="vehicleForm.workshop_code" class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500 dark:bg-gray-900 dark:border-gray-700" />
        </div>
        <div>
          <label class="block text-sm mb-1">نوع خودرو</label>
          <select x-model="vehicleForm.vehicle_type" class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500 dark:bg-gray-900 dark:border-gray-700">
            <option value="fire_truck">خودروی آتش‌نشانی</option>
            <option value="ambulance">آمبولانس</option>
            <option value="rescue">امداد و نجات</option>
          </select>
        </div>
        <div>
          <label class="block text-sm mb-1">وضعیت</label>
          <select x-model="vehicleForm.status" class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500 dark:bg-gray-900 dark:border-gray-700">
            <option value="active">فعال</option>
            <option value="inactive">غیرفعال</option>
            <option value="maintenance">تعمیر</option>
          </select>
        </div>
        <div>
          <label class="block text-sm mb-1">پلاک</label>
          <input x-model="vehicleForm.license_plate" class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500 dark:bg-gray-900 dark:border-gray-700" />
        </div>
        <div>
          <label class="block text-sm mb-1">مدل</label>
          <input x-model="vehicleForm.model" class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500 dark:bg-gray-900 dark:border-gray-700" />
        </div>
        <div>
          <label class="block text-sm mb-1">سال ساخت</label>
          <input x-model.number="vehicleForm.manufacture_year" type="number" class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500 dark:bg-gray-900 dark:border-gray-700" />
        </div>
        <div>
          <label class="block text-sm mb-1">آخرین سرویس</label>
          <input x-ref="last_maintenance_date" x-model="vehicleForm.last_maintenance_date" class="jalali w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500 dark:bg-gray-900 dark:border-gray-700" />
        </div>
        <div>
          <label class="block text-sm mb-1">سرویس بعدی</label>
          <input x-ref="next_maintenance_date" x-model="vehicleForm.next_maintenance_date" class="jalali w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500 dark:bg-gray-900 dark:border-gray-700" />
        </div>
        <div>
          <label class="block text-sm mb-1">پایان بیمه</label>
          <input x-ref="insurance_expiry" x-model="vehicleForm.insurance_expiry" class="jalali w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500 dark:bg-gray-900 dark:border-gray-700" />
        </div>
        <div>
          <label class="block text-sm mb-1">پایان معاینه فنی</label>
          <input x-ref="technical_inspection_expiry" x-model="vehicleForm.technical_inspection_expiry" class="jalali w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500 dark:bg-gray-900 dark:border-gray-700" />
        </div>
        <div class="sm:col-span-2 lg:col-span-3">
          <label class="block text-sm mb-1">توضیحات</label>
          <textarea x-model="vehicleForm.description" rows="2" class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500 dark:bg-gray-900 dark:border-gray-700"></textarea>
        </div>
      </div>
      <div class="mt-4 border-t pt-3 grid grid-cols-2 sm:grid-cols-3 gap-2">
        <template x-for="eq in vehicleEquipments" :key="eq.key">
          <label class="flex items-center gap-2 text-sm">
            <input type="checkbox" :id="'veh_' + eq.key" :checked="vehicleForm[eq.key]" @change="vehicleForm[eq.key] = $event.target.checked" class="rounded border-gray-300 text-brand-600 focus:ring-brand-500">
            <span x-text="eq.label"></span>
          </label>
        </template>
      </div>
      <div class="mt-4 flex items-center justify-end gap-2">
        <button @click="closeVehicleModal()" class="rounded-md border px-4 py-2 text-sm">انصراف</button>
        <button @click="saveVehicle()" class="rounded-md bg-brand-600 px-4 py-2 text-sm text-white">ذخیره</button>
      </div>
    </div>
  </div>

  <!-- Simple Modal (mineral types, workgroups, machine types, dumps) -->
  <div x-show="modals.simple" x-cloak class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4">
    <div @click.away="closeSimpleModal()" class="w-full max-w-xl rounded-lg bg-white p-4 shadow-xl dark:bg-gray-800">
      <h3 class="text-lg font-semibold mb-4" x-text="simpleForm.title"></h3>
      <div class="grid grid-cols-1 gap-3">
        <div>
          <label class="block text-sm mb-1">نام</label>
          <input x-model="simpleForm.name" class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500 dark:bg-gray-900 dark:border-gray-700" />
        </div>
        <div>
          <label class="block text-sm mb-1">توضیحات</label>
          <textarea x-model="simpleForm.description" rows="2" class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500 dark:bg-gray-900 dark:border-gray-700"></textarea>
        </div>
        <template x-if="activeTab === 'machine_types'">
          <div>
            <label class="block text-sm mb-1">گروه کاری</label>
            <select x-model.number="simpleForm.machine_workgroup" class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500 dark:bg-gray-900 dark:border-gray-700">
              <option value="">-- انتخاب --</option>
              {% for wg in workgroups %}
              <option value="{{ wg.id }}">{{ wg.name }}</option>
              {% endfor %}
            </select>
          </div>
        </template>
      </div>
      <div class="mt-4 flex items-center justify-end gap-2">
        <button @click="closeSimpleModal()" class="rounded-md border px-4 py-2 text-sm">انصراف</button>
        <button @click="saveSimple()" class="rounded-md bg-brand-600 px-4 py-2 text-sm text-white">ذخیره</button>
      </div>
    </div>
  </div>

  <!-- Delete Confirm Modal -->
  <div x-show="modals.delete" x-cloak class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4">
    <div @click.away="modals.delete=false" class="w-full max-w-md rounded-lg bg-white p-4 shadow-xl dark:bg-gray-800">
      <h3 class="text-lg font-semibold mb-4">حذف رکورد</h3>
      <p class="text-sm text-gray-600 dark:text-gray-300" x-text="deleteMessage"></p>
      <div class="mt-4 flex items-center justify-end gap-2">
        <button @click="modals.delete=false" class="rounded-md border px-4 py-2 text-sm">انصراف</button>
        <button @click="doDelete()" class="rounded-md bg-red-600 px-4 py-2 text-sm text-white">حذف</button>
      </div>
    </div>
  </div>
</div>
{% endblock %}

{% block scripts %}
  <script src="https://cdn.jsdelivr.net/npm/@majidh1/jalalidatepicker/dist/jalalidatepicker.min.js"></script>
  <script>
    function coreSettings() {
      return {
        tabs: [
          { key: 'machines', label: 'دستگاه‌های معدنی' },
          { key: 'blocks', label: 'بلوک‌ها' },
          { key: 'dumps', label: 'دمپ‌ها' },
          { key: 'vehicles', label: 'خودروهای امدادی' },
          { key: 'mineral_types', label: 'انواع سنگ' },
          { key: 'workgroups', label: 'گروه‌های کاری' },
          { key: 'machine_types', label: 'نوع دستگاه' },
        ],
        simpleTabs: [
          { key: 'mineral_types', title: 'مدیریت انواع سنگ', stateKey: 'mineral_types', endpoint: '/baseinfo/api/mineral-types/' },
          { key: 'workgroups', title: 'مدیریت گروه‌های کاری', stateKey: 'workgroups', endpoint: '/baseinfo/api/workgroups/' },
          { key: 'machine_types', title: 'مدیریت نوع دستگاه', stateKey: 'machine_types', endpoint: '/baseinfo/api/machine-types/' },
          { key: 'dumps', title: 'مدیریت دمپ‌ها', stateKey: 'dumps', endpoint: '/baseinfo/api/dumps/' },
        ],
        activeTab: 'machines',
        state: {
          machines: [],
          blocks: [],
          vehicles: [],
          mineral_types: [],
          workgroups: [],
          machine_types: [],
          dumps: [],
        },
        filters: { machines: { search: '' } },
        modals: { machine: false, block: false, vehicle: false, simple: false, delete: false },
        machineTypeOptions: [],
        machineForm: { id: null, workshop_code: '', machine_workgroup: '', machine_type: '', ownership: 'Company', contractor: '', is_active: true },
        blockForm: { id: null, block_name: '', type: 'w', status: 'initial_preparation', location: '', is_active: true },
        vehicleForm: { id: null, vehicle_type: 'fire_truck', workshop_code: '', license_plate: '', model: '', manufacture_year: '', status: 'active', last_maintenance_date: '', next_maintenance_date: '', insurance_expiry: '', technical_inspection_expiry: '', description: '', has_horn: true, has_hose: true, has_monitor: true, has_extinguisher: true, has_equipment: true, has_foam: true, has_water: true, has_tire: true, has_brake: true, has_lighting: true },
        simpleForm: { id: null, title: '', name: '', description: '', machine_workgroup: '' },
        deleteContext: { type: null, id: null },
        deleteMessage: '',
        vehicleEquipments: [
          { key: 'has_horn', label: 'بوق و چراغ گردان' },
          { key: 'has_hose', label: 'شیلنگ و اتصالات' },
          { key: 'has_monitor', label: 'مانیتور' },
          { key: 'has_extinguisher', label: 'خاموش‌کننده دستی' },
          { key: 'has_equipment', label: 'تجهیزات آتش‌نشانی' },
          { key: 'has_foam', label: 'پودر و فوم' },
          { key: 'has_water', label: 'آب' },
          { key: 'has_tire', label: 'لاستیک' },
          { key: 'has_brake', label: 'سیستم ترمز' },
          { key: 'has_lighting', label: 'سیستم روشنایی' },
        ],

        init() {
          this.fetchMachines();
          this.fetchBlocks();
          this.fetchVehicles();
          this.fetchSimple('mineral_types');
          this.fetchSimple('workgroups');
          this.fetchSimple('machine_types');
          this.fetchSimple('dumps');

          this.$watch('filters.machines.search', () => this.fetchMachines());
        },

        // Utils
        formatDate(d) { return d ? new Date(d).toLocaleDateString('fa-IR') : '' },
        badgeForBlockType(type) {
          return type.includes('پرعیار') ? 'bg-green-100 text-green-700' : (type.includes('باطله') ? 'bg-gray-100 text-gray-700' : 'bg-blue-100 text-blue-700');
        },
        badgeForBlockStatus(status) {
          const map = {
            'آماده بارگیری': 'bg-green-100 text-green-700',
            'در حال بارگیری': 'bg-yellow-100 text-yellow-700',
            'اتمام بلوک': 'bg-gray-100 text-gray-700'
          };
          return map[status] || 'bg-indigo-100 text-indigo-700';
        },
        badgeForVehicleStatus(status) {
          const map = { 'فعال': 'bg-green-100 text-green-700', 'غیرفعال': 'bg-red-100 text-red-700', 'در حال تعمیر': 'bg-yellow-100 text-yellow-700' };
          return map[status] || 'bg-gray-100 text-gray-700';
        },

        // Fetchers
        async fetchMachines() {
          const params = new URLSearchParams();
          if (this.filters.machines.search) params.set('search', this.filters.machines.search);
          const res = await fetch(`/baseinfo/api/machines/?${params.toString()}`);
          const j = await res.json();
          this.state.machines = j.data;
        },
        async fetchBlocks() {
          const res = await fetch('/baseinfo/api/blocks/');
          const j = await res.json();
          this.state.blocks = j.data;
        },
        async fetchVehicles() {
          const res = await fetch('/baseinfo/api/emergency-vehicles/');
          const j = await res.json();
          this.state.vehicles = j.data;
        },
        async fetchSimple(key) {
          const conf = this.simpleTabs.find(s => s.key === key);
          const res = await fetch(conf.endpoint);
          const j = await res.json();
          this.state[key] = j.data;
        },
        async fetchMachineTypes(workgroupId) {
          if (!workgroupId) { this.machineTypeOptions = []; return }
          const res = await fetch(`/baseinfo/api/machine-types-by-workgroup/${workgroupId}/`);
          const j = await res.json();
          this.machineTypeOptions = j.data;
        },

        // Modals and forms
        openMachineModal(item=null) {
          this.modals.machine = true;
          if (item) {
            this.machineForm = { id: item.id, workshop_code: item.workshop_code, machine_workgroup: '', machine_type: '', ownership: item.ownership === 'پیمانکار' ? 'Contractor' : 'Company', contractor: '', is_active: item.is_active };
          } else {
            this.machineForm = { id: null, workshop_code: '', machine_workgroup: '', machine_type: '', ownership: 'Company', contractor: '', is_active: true };
          }
        },
        closeMachineModal(){ this.modals.machine = false },
        async saveMachine(){
          const payload = { ...this.machineForm };
          const method = this.machineForm.id ? 'PUT' : 'POST';
          const url = this.machineForm.id ? `/baseinfo/api/machines/${this.machineForm.id}/` : '/baseinfo/api/machines/';
          const res = await fetch(url, { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
          if (res.ok) { this.modals.machine=false; this.fetchMachines(); }
        },
        async toggleMachineActive(item){
          const res = await fetch(`/baseinfo/api/machines/${item.id}/`);
          const j = await res.json();
          const updated = { ...j.data, is_active: !item.is_active };
          await fetch(`/baseinfo/api/machines/${item.id}/`, { method:'PUT', headers:{'Content-Type':'application/json'}, body: JSON.stringify(updated) });
          this.fetchMachines();
        },

        openBlockModal(item=null){
          this.modals.block = true;
          this.blockForm = item ? { id: item.id, block_name: item.block_name, type: this.reverseBlockType(item.type), status: this.reverseBlockStatus(item.status), location: item.location, is_active: item.is_active } : { id:null, block_name:'', type:'w', status:'initial_preparation', location:'', is_active:true };
        },
        closeBlockModal(){ this.modals.block=false },
        reverseBlockType(d){ if (d.includes('باطله')) return 'w'; if (d.includes('پرعیار')) return 'o'; return 'w&o'; },
        reverseBlockStatus(s){
          const map = {
            'آماده سازی اولیه': 'initial_preparation', 'آماده حفاری': 'ready_for_drilling', 'آماده آتش باری': 'ready_for_blasting', 'آماده بارگیری': 'ready_for_loading', 'در حال بارگیری': 'loading', 'اتمام بلوک': 'completed'
          }; return map[s] || 'initial_preparation';
        },
        async saveBlock(){
          const payload = { ...this.blockForm };
          const method = this.blockForm.id ? 'PUT' : 'POST';
          const url = this.blockForm.id ? `/baseinfo/api/blocks/${this.blockForm.id}/` : '/baseinfo/api/blocks/';
          const res = await fetch(url, { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
          if (res.ok) { this.modals.block=false; this.fetchBlocks(); }
        },

        openVehicleModal(item=null){
          this.modals.vehicle = true;
          this.$nextTick(() => { jalaliDatepicker.startWatch({ time: false }); });
          if (item){
            fetch(`/baseinfo/api/emergency-vehicles/${item.id}/`).then(r=>r.json()).then(j=>{ this.vehicleForm = { ...j.data } })
          } else {
            this.vehicleForm = { id: null, vehicle_type: 'fire_truck', workshop_code: '', license_plate: '', model: '', manufacture_year: '', status: 'active', last_maintenance_date: '', next_maintenance_date: '', insurance_expiry: '', technical_inspection_expiry: '', description: '', has_horn: true, has_hose: true, has_monitor: true, has_extinguisher: true, has_equipment: true, has_foam: true, has_water: true, has_tire: true, has_brake: true, has_lighting: true };
          }
        },
        closeVehicleModal(){ this.modals.vehicle=false },
        async saveVehicle(){
          const payload = { ...this.vehicleForm };
          const method = this.vehicleForm.id ? 'PUT' : 'POST';
          const url = this.vehicleForm.id ? `/baseinfo/api/emergency-vehicles/${this.vehicleForm.id}/` : '/baseinfo/api/emergency-vehicles/';
          const res = await fetch(url, { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
          if (res.ok) { this.modals.vehicle=false; this.fetchVehicles(); }
        },

        openSimpleModal(key, item=null){
          this.modals.simple = true;
          const t = this.simpleTabs.find(s=>s.key===key);
          this.simpleForm = item ? { id:item.id, title: t.title, name:item.name, description:item.description, machine_workgroup: '' } : { id:null, title: t.title, name:'', description:'', machine_workgroup:'' };
        },
        closeSimpleModal(){ this.modals.simple=false },
        async saveSimple(){
          const key = this.activeTab;
          const conf = this.simpleTabs.find(s => s.key === key);
          const method = this.simpleForm.id ? 'PUT' : 'POST';
          const url = this.simpleForm.id ? `${conf.endpoint}${this.simpleForm.id}/` : conf.endpoint;
          const payload = { name: this.simpleForm.name, description: this.simpleForm.description };
          if (key === 'machine_types') payload.machine_workgroup = this.simpleForm.machine_workgroup || null;
          const res = await fetch(url, { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
          if (res.ok) { this.modals.simple=false; this.fetchSimple(key); }
        },

        confirmDelete(type, item){
          this.modals.delete = true;
          this.deleteContext = { type, id: item.id };
          this.deleteMessage = `آیا از حذف ${this.humanType(type)} با شناسه ${item.id} مطمئنید؟`;
        },
        humanType(t){
          const m = { 'machine':'دستگاه', 'block':'بلوک', 'vehicles':'خودرو', 'mineral_types':'نوع سنگ', 'workgroups':'گروه کاری', 'machine_types':'نوع دستگاه', 'dumps':'دمپ', 'vehicle':'خودرو' };
          return m[t] || 'رکورد';
        },
        async doDelete(){
          const { type, id } = this.deleteContext;
          const map = {
            machine: `/baseinfo/api/machines/${id}/`, block: `/baseinfo/api/blocks/${id}/`, vehicle: `/baseinfo/api/emergency-vehicles/${id}/`, mineral_types: `/baseinfo/api/mineral-types/${id}/`, workgroups: `/baseinfo/api/workgroups/${id}/`, machine_types: `/baseinfo/api/machine-types/${id}/`, dumps: `/baseinfo/api/dumps/${id}/`
          };
          const res = await fetch(map[type], { method:'DELETE' });
          if (res.ok) {
            this.modals.delete = false;
            if (type==='machine') this.fetchMachines();
            else if (type==='block') this.fetchBlocks();
            else if (type==='vehicle') this.fetchVehicles();
            else this.fetchSimple(type);
          }
        },
      }
    }
  </script>
{% endblock %}
